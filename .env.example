# MCP server URL. For Docker Desktop, host.docker.internal reaches services
# published on the Windows host.
MCP_SERVER_URL=http://host.docker.internal:8090/mcp

# Use Ollama by default. Pull this model on the host with: ollama pull llama3.2
AI_PROVIDER=ollama
AI_MODEL=llama3.2
AI_BASE_URL=http://host.docker.internal:11434
AI_API_KEY=your_api_key_here

# For an OpenAI-compatible paid provider, set:
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=your-tool-capable-model
